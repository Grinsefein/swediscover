# BFF Environment Configuration
# Copy this file to .env and fill in your actual API keys from Trafiklab

# Required: Trafiklab API Keys (get them at https://www.trafiklab.se/)
RESROBOT_API_KEY=your_resrobot_api_key_here
STOPS_API_KEY=your_stops_api_key_here
GTFS_RT_API_KEY=your_gtfs_realtime_api_key_here

# Optional: GTFS Static Key (for importing stop data into the app)
GTFS_STATIC_API_KEY=your_gtfs_static_api_key_here

# Optional: Custom GTFS-RT URL (overrides operator-based URLs)
# GTFS_RT_URL=https://opendata.samtrafiken.se/gtfs-rt-sweden/sl/VehiclePositionsSweden.pb?key=...

# Server Configuration (optional, defaults shown)
BFF_HOST=0.0.0.0
BFF_PORT=8080

# GTFS-RT Polling Interval (seconds)
GTFS_RT_POLL_SECONDS=30

# WebSocket Broadcast Interval (milliseconds)
BROADCAST_MS=500

# Request Collapse Window (milliseconds)
COLLAPSE_WINDOW_MS=1500

# Comma-separated list of operators to poll (SL, Västtrafik, Skånetrafiken, etc.)
GTFS_RT_OPERATORS=sl,vasttrafik,skanetrafiken,xt
