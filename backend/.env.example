# .env - Environment Variables für SweDiscover Backend
# NIEMALS ins Git committen!

# Trafiklab API Keys (von https://www.trafiklab.se/api)
TRAFIKLAB_API_KEY=dein_resrobot_api_key
TRAFIKLAB_GTFS_RT_KEY=dein_gtfs_realtime_key
TRAFIKLAB_GTFS_STATIC_KEY=dein_gtfs_static_key
TRAFIKLAB_STOPS_KEY=dein_stops_api_key
TRAFIKLAB_RESROBOT_KEY=dein_resrobot_key

# Trafikverket API Key (für Camera, Situation, etc.)
TRAFIKVERKET_API_KEY=dein_trafikverket_key

# Server Konfiguration
SERVER_PORT=8080
